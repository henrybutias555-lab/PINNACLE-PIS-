# Copy to .env and adjust. Never commit the real .env.
PIS_SECRET_KEY=change-me-to-a-long-random-string
PIS_DATABASE_URL=sqlite:///./data/pis.db
PIS_UPLOAD_DIR=./data/uploads
PIS_DEFAULT_CURRENCY=GHS
# First admin account (created on first start if no users exist)
PIS_ADMIN_EMAIL=admin@pinnacle.local
PIS_ADMIN_PASSWORD=ChangeMe123!
# Claude AI (optional). Without a key the system uses rule-based extraction
# and template commentary.
ANTHROPIC_API_KEY=
PIS_CLAUDE_MODEL=claude-opus-5-5
